{
  "name": "wyswyg",
  "version": "1.1.0",
  "description": "Editor WYSIWYG modern berbasis vanilla JS + Alpine.js dengan engine Tiptap/ProseMirror: bubble toolbar, slash command, markdown, gambar & video, sanitasi HTML.",
  "type": "module",
  "main": "./dist/wyswyg.js",
  "module": "./dist/wyswyg.js",
  "exports": {
    ".": "./dist/wyswyg.js",
    "./style.css": "./dist/wyswyg.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tests/browser/run.mjs"
  },
  "peerDependencies": {
    "alpinejs": "^3.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "alpinejs": "^3.17.4",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "wysiwyg",
    "editor",
    "rich-text",
    "contenteditable",
    "alpinejs",
    "markdown"
  ],
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0"
  }
}
