{
  "name": "afwrite",
  "version": "2.1.0",
  "description": "Editor WYSIWYG ala Medium untuk Alpine.js, berbasis Tiptap/ProseMirror: bubble toolbar, slash command, markdown, mode artikel, gambar & video, drag & drop blok, sanitasi HTML.",
  "type": "module",
  "main": "./dist/afwrite.js",
  "module": "./dist/afwrite.js",
  "unpkg": "./dist/afwrite.min.js",
  "jsdelivr": "./dist/afwrite.min.js",
  "exports": {
    ".": "./dist/afwrite.js",
    "./style.css": "./dist/afwrite.css",
    "./standalone": "./dist/afwrite.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.standalone.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tests/browser/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agungfwcoder/afwrite.git"
  },
  "homepage": "https://agungfwcoder.github.io/afwrite/",
  "bugs": "https://github.com/agungfwcoder/afwrite/issues",
  "peerDependencies": {
    "alpinejs": "^3.0.0"
  },
  "license": "MIT",
  "author": "agungfwcoder",
  "devDependencies": {
    "alpinejs": "^3.17.4",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "wysiwyg",
    "editor",
    "rich-text",
    "contenteditable",
    "alpinejs",
    "markdown",
    "tiptap",
    "prosemirror",
    "medium",
    "laravel"
  ],
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0"
  }
}
